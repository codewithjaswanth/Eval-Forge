# ==============================================================================
# EvalForge Worker Environment Configuration Template
# ==============================================================================

# Database & Queue Connection (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
# Worker requires service_role key to invoke claim_next_evaluation_run() and persist records
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key

# Worker Instance Identity
WORKER_ID=worker-prod-01

# LLM Providers (ProblemAnalyzer, SolutionAnalyzer, etc.)
EVALFORGE_LLM_PROVIDER=gemini # options: gemini, anthropic, openai, mock
EVALFORGE_LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Search Engines (NoveltyAnalyzer)
SEARCH_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# Isolated Sandbox Container Runtime
CONTAINER_RUNTIME=docker # options: docker, podman
EVALFORGE_SANDBOX_IMAGE=evalforge-sandbox:latest

# Logging & Observability
LOG_LEVEL=INFO # options: DEBUG, INFO, WARNING, ERROR
STRUCTURED_JSON_LOGGING=true
