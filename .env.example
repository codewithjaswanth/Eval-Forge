# ==============================================================================
# EvalForge Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local orchestration or see specific subpackages:
# - apps/web/.env.example
# - services/worker/.env.example
# ==============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key

# LLM Intelligence Providers
EVALFORGE_LLM_PROVIDER=gemini # options: gemini, anthropic, openai, mock
EVALFORGE_LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Research & External APIs (NoveltyAnalyzer)
SEARCH_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# Worker & Sandbox Configuration
WORKER_ID=worker-prod-01
CONTAINER_RUNTIME=docker # options: docker, podman
EVALFORGE_SANDBOX_IMAGE=evalforge-sandbox:latest
